---
# Adoption stub for an RGW account that exists on the cluster but is not in
# rgw_tenants_list, written by rgw_tenants discovery. Nothing on the cluster was changed.
#
# To bring it under management:
#   1. Review and edit the entry below (name/root_user/buckets, add quota/limits/roles).
{% set slug = _rgw_tenants_acct.slug | default('', true) or (_rgw_tenants_acct.id | lower) %}
{% set var_slug = slug | replace('-', '_') %}
#   2. Add the account-root's existing S3 keys to your vault as
#        vault_rgw_tenants_{{ var_slug }}_access_key
#        vault_rgw_tenants_{{ var_slug }}_secret_key
#      The role reuses them, and does not re-create the root user unless you set
#      rotate_keys: true, which rolls the keys to the vaulted value.
#   3. Rename this file <slug>.yml, drop it into the directory rgw_tenants_dir points at,
#      and run the rgw_tenants role. state defaults to present.
{% if not _rgw_tenants_acct.slug %}
# WARNING: the tenant slug could not be derived from the role/bucket prefixes (they
# disagree or are absent), so "{{ slug }}" below is a placeholder from the account id. Set
# `name` to the real slug (the common prefix of the roles/buckets) before adopting.
{% endif %}
rgw_tenant_{{ var_slug }}:
  name: {{ slug }}   # account name on cluster: {{ _rgw_tenants_acct.name | default('(unnamed)', true) }}
  account_id: "{{ _rgw_tenants_acct.id }}"
{% if _rgw_tenants_acct.root_user %}
  root_user: {{ _rgw_tenants_acct.root_user }}   # discovered account user(s): {{ _rgw_tenants_acct.users | join(', ') }}
{% endif %}
{% if _rgw_tenants_acct.buckets | length > 0 %}
  buckets:
{% for b in _rgw_tenants_acct.buckets %}
    - {{ b }}
{% endfor %}
{% else %}
  buckets: []
{% endif %}
  # quota: {}      # optional {enabled, max_size(bytes/-1), max_objects(count/-1)}
  # limits: {}     # optional entity caps, reconciled by rgw_iam (-1 = unlimited)
  # discovered IAM roles: {{ _rgw_tenants_acct.roles | join(', ') if _rgw_tenants_acct.roles else '(none)' }}

# Append this tenant's existing account-root keys here as inline !vault, so the file is
# self-contained the way rgw_new_tenant writes one:
#   ansible-vault encrypt_string --stdin-name vault_rgw_tenants_{{ var_slug }}_access_key
#   ansible-vault encrypt_string --stdin-name vault_rgw_tenants_{{ var_slug }}_secret_key
