---
# Example vault contents. In a real deployment these live in your ansible-vault'd
# environments/<env>/secrets.yml. Never commit plaintext.
#
# STS signing key, 16+ random chars:
#   tr -dc 'A-Za-z0-9' </dev/urandom | head -c 16
vault_rgw_sts_key: "REPLACE-ME-16-CHARS"

# Per-tenant account-root S3 keys, looked up by name for every tenant in rgw_tenants_list
# and asserted defined before provisioning.
#   access key: tr -dc 'A-Z0-9' </dev/urandom | head -c 20
#   secret key: tr -dc 'A-Za-z0-9' </dev/urandom | head -c 40
vault_rgw_tenants_acme_access_key: "REPLACE-ME-20-CHARS"
vault_rgw_tenants_acme_secret_key: "REPLACE-ME-40-CHARS"
vault_rgw_tenants_globex_access_key: "REPLACE-ME-20-CHARS"
vault_rgw_tenants_globex_secret_key: "REPLACE-ME-40-CHARS"
