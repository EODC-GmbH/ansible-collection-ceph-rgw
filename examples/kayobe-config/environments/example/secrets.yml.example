---
# Example vault contents. In a real deployment these live in your ansible-vault'd
# environments/<env>/secrets.yml. Never commit plaintext.
#
# STS signing key, 16+ random chars:
#   tr -dc 'A-Za-z0-9' </dev/urandom | head -c 16
vault_rgw_sts_key: "REPLACE-ME-16-CHARS"

# Per-tenant account-root S3 keys, looked up by name for every tenant in rgw_tenants_list
# and asserted defined before provisioning.
#   access key: tr -dc 'A-Z0-9' </dev/urandom | head -c 20
#   secret key: tr -dc 'A-Za-z0-9' </dev/urandom | head -c 40
vault_rgw_tenants_aviato_access_key: "REPLACE-ME-20-CHARS"
vault_rgw_tenants_aviato_secret_key: "REPLACE-ME-40-CHARS"
vault_rgw_tenants_hooli_access_key: "REPLACE-ME-20-CHARS"
vault_rgw_tenants_hooli_secret_key: "REPLACE-ME-40-CHARS"

# Entries under a tenant's root_users and users take their keys from the same pattern,
# with _root_<name> or _svc_<name> after the tenant (hyphens in the tenant become _).
# The rgw_add_root_user / rgw_add_service_user playbooks write them, vaulted, into the tenant drop-in.
# vault_rgw_tenants_aviato_root_erika_schroeder_access_key: "REPLACE-ME-20-CHARS"
# vault_rgw_tenants_aviato_root_erika_schroeder_secret_key: "REPLACE-ME-40-CHARS"
# vault_rgw_tenants_aviato_svc_backup_access_key: "REPLACE-ME-20-CHARS"
# vault_rgw_tenants_aviato_svc_backup_secret_key: "REPLACE-ME-40-CHARS"
