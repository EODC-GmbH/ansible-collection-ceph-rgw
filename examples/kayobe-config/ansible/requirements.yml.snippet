---
# Add this entry under the `collections:` list in etc/kayobe/ansible/requirements.yml;
# `kayobe control host bootstrap` runs ansible-galaxy against that file. Pin `version` to
# a tag or commit; a branch tracks its tip. To vendor the collection instead, see the
# README's Install section.
collections:
  - name: https://github.com/EODC-GmbH/ansible-collection-ceph-rgw.git
    type: git
    version: main/2025.1
