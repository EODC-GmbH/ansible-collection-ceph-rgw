---
# Append to etc/kayobe/ansible/ceph/cephadm.yml after the "Import Cephadm commands post
# playbook" line. Keep this order: tenants asserts STS is on, and IAM's trust policies name
# the providers tenants registers.

- name: Import Cephadm STS playbook
  import_playbook: cephadm-sts.yml

- name: Import Cephadm tenants (multi-tenant S3) playbook
  import_playbook: cephadm-tenants.yml

- name: Import Cephadm IAM (tenant roles + policies) playbook
  import_playbook: cephadm-iam.yml
