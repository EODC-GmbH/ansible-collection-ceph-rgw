---
# Append these two imports to etc/kayobe/ansible/ceph/cephadm.yml, after the existing
# "Import Cephadm commands post playbook" line. Keep them in this order: STS sets rgw_sts_key /
# rgw_s3_auth_use_sts and restarts RGW, and the tenants play needs STS already on.

- name: Import Cephadm STS playbook
  import_playbook: cephadm-sts.yml

- name: Import Cephadm tenants (multi-tenant S3) playbook
  import_playbook: cephadm-tenants.yml
