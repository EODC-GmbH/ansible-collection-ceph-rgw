---
# Mirrors the kayobe-config conventions these roles slot into (it skips line-length too).
skip_list:
  # Wrapping the radosgw-admin command strings would split them mid-line.
  - yaml[line-length]
  # Not published to Galaxy, no changelog shipped yet.
  - galaxy[no-changelog]
  # var-naming[no-role-prefix] stays enforced on purpose: every variable is rgw_sts_* / rgw_tenants_*.
