---
# Mirrors the kayobe-config conventions these roles slot into.
skip_list:
  # Wrapping the folded `cephadm shell -- bash -c '...'` command strings would split them
  # mid-line. kayobe-config skips this rule too.
  - yaml[line-length]
  # Not published to Galaxy.
  - galaxy[no-changelog]
  # var-naming[no-role-prefix] is deliberately NOT skipped: every variable is
  # role-name-prefixed, so the rule stays enforced.
