# shellcheck shell=bash disable=SC2034
# The test cluster for converge_twice.sh, capture_rgw.sh and scenarios.sh.
#
# Copy to ~/.config/ceph_rgw-tests/test-cluster.env (or pass -c <file>). The scripts ignore any
# RGW_TEST_* exported in the shell and read only this file. Every run first checks that the
# hosts the runner reaches, and RGW_TEST_SSH, carry RGW_TEST_FSID in /etc/ceph/ceph.conf, and
# stops before changing anything if not. Use a cluster you can lose: the runs create, break and
# delete accounts, keys and roles, and restart RGW.

# fsid of the test cluster (`ceph fsid`). Required.
RGW_TEST_FSID=00000000-0000-0000-0000-000000000000

# The command that runs a playbook against that cluster; the scripts append the playbook
# and their flags. Required.
RGW_TEST_RUNNER=(kayobe playbook run)
# RGW_TEST_RUNNER=(ansible-playbook -i /srv/hooli-test/inventory -e @/srv/hooli-test/rgw.yml)

# With kayobe: the run stops unless the shell's KAYOBE_ENVIRONMENT matches.
RGW_TEST_KAYOBE_ENVIRONMENT=hooli-test

# ---- scenarios.sh only ----------------------------------------------------------------
# Host running the ceph containers, reached with ssh + sudo. Required.
RGW_TEST_SSH=hooli-ceph0
# docker or podman on that host (default: whichever it has).
# RGW_TEST_RUNTIME=podman
# RGW S3/IAM URL as seen from RGW_TEST_SSH (boto3 must be importable there).
RGW_TEST_ENDPOINT=http://hooli-ceph0:8080
# Drop-in directory of the test cluster's tenants; only read. Required.
RGW_TEST_TENANTS_DIR=/srv/hooli-test/rgw_tenants.d
# Throwaway tenant; an existing one of that name is purged first.
# RGW_TEST_TENANT=citest
# Ceph image for radosgw-admin/ceph (default: the image of the host's running mon container).
# RGW_TEST_IMAGE=quay.io/ceph/ceph:v19
# Keeps the test drop-in between runs.
# RGW_TEST_STATE_DIR=~/.cache/ceph_rgw-scenarios

# ---- federation step (skipped unless RGW_TEST_IDP and RGW_TEST_KC_ADMIN are set) ------
# With those set, RGW_TEST_CLIENT is required too. Use a test realm: the step creates and
# removes users and groups.
# RGW_TEST_IDP=https://sso.hooli-test.example/realms/hooli-test/protocol/openid-connect/token
# Your command for throwaway IdP users, called as
#   <cmd> user <name> <password> <group-path>...   create or reset
#   <cmd> rm-user <name>
#   <cmd> rm-group <group-path>
# RGW_TEST_KC_ADMIN=/path/to/kc-test-users
# OIDC client id the test users log in with.
# RGW_TEST_CLIENT=hooli-s3
# Grant group root, if not the collection default /services/s3.
# RGW_TEST_GRANT_ROOT=/services/s3
